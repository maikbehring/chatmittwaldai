# Pflicht: API-Key aus dem mStudio (Organisation/Projekt → AI-Hosting)
MITTWALD_AI_API_KEY=sk-…

# Optional: Standard ist die offizielle mittwald-Base-URL
# MITTWALD_AI_BASE_URL=https://llm.aihosting.mittwald.de/v1

# Server-Port
PORT=8787

# Optionaler zusätzlicher Zugriffsschutz für kostenintensive Endpunkte:
# Wenn gesetzt, muss jeder Request auf /api/chat/completions, /api/audio/transcriptions
# und /api/web/search den Header `x-playground-api-key` mit diesem Wert senden.
# PLAYGROUND_APP_API_KEY=change-me-to-a-long-random-secret

# Kommagetrennte Modell-IDs (müssen exakt zu /v1/models passen). Ohne gpt-oss/Qwen erscheinen
# diese nicht im Dropdown — sie sind im Playground bereits mit Doku-Presets verdrahtet.
# Für öffentliche Playgrounds die Liste bewusst kürzen.
PLAYGROUND_ALLOWED_MODELS=Ministral-3-14B-Instruct-2512,gpt-oss-120b,Qwen3.5-0.8B,Qwen3.5-122B-A10B-FP8,Qwen3.6-35B-A3B-FP8,GLM-OCR

# Rate-Limit (pro IP) — Werte erscheinen im UI-Hinweis bei 429 (z. B. „40 Chat-Nachrichten pro 15 Minuten“)
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_GLOBAL=300
RATE_LIMIT_MAX_CHAT=40
# „Weiter testen“-Button im Limit-Dialog: zusätzliche Chat-Anfragen pro Klick (pro IP, pro Fenster)
# PLAYGROUND_BONUS_CHAT_REQUESTS=5
# PLAYGROUND_BONUS_MAX_GRANTS_PER_WINDOW=1

# Rate-Limit für Modellliste (pro IP)
RATE_LIMIT_MAX_MODELS=120

# JSON-Body maximal (Bytes)
MAX_BODY_BYTES=10485760

# Max. Nachrichten pro Chat-Request (System + Verlauf); Schutz vor riesigen Prompts
# PLAYGROUND_MAX_MESSAGES=60
# Max. Zeichen pro Nachricht (Standard-Use-Cases)
# PLAYGROUND_MAX_MESSAGE_CHARS=48000
# Höheres Limit für AI-Hosting-Tarifberater (voller FAQ-/Tarif-Kontext im ersten Turn)
# PLAYGROUND_TARIFF_ADVISOR_MAX_MESSAGE_CHARS=120000

# CORS: Kommagetrennte Origins; * nur für lokale Tests
CORS_ORIGIN=http://localhost:5173
# Origin-Prüfung für kostenintensive POST-Routen (empfohlen in Produktion)
# REQUIRE_ORIGIN_CHECK=1

# Öffentlicher Pfad unter der Domain (Vite base + API-Prefix), z. B. /ai unter playground.mittwald.de
# Lokal: weglassen — Produktion/Docker: /ai
# VITE_APP_BASE_PATH=/ai/
# PLAYGROUND_BASE_PATH=/ai

# Strommix-Badge (Carbon-Aware-Forecast DE, g CO₂/kWh)
# PLAYGROUND_GRID_CARBON_ENABLED=0
# PLAYGROUND_GRID_CARBON_FORECAST_URL=https://carbonawarecomputing.blob.core.windows.net/forecasts/de.json

# Optional: Umami Analytics (nur wenn Website-ID gesetzt — Script wird in index.html eingefügt)
# VITE_UMAMI_SCRIPT_SRC=https://cloud.umami.is/script.js
# VITE_UMAMI_WEBSITE_ID=423e42f0-9310-4efa-9a0d-30d8e0437c5f
# Self-hosted später z. B.:
# VITE_UMAMI_SCRIPT_SRC=https://analytics.example.com/script.js

# Hinter Reverse-Proxy (X-Forwarded-For) — für echte Client-IPs bei Rate-Limit
TRUST_PROXY=0

# Öffentlicher Titel (optional)
PLAYGROUND_BRAND_TITLE=Mittwald KI-Playground

# Footer-/Sidebar-Links (nur gesetzte URLs erscheinen im UI)
# PLAYGROUND_LINK_IMPRESSUM_URL=https://example.com/impressum
# PLAYGROUND_LINK_IMPRESSUM_LABEL=Impressum
# PLAYGROUND_LINK_PRIVACY_URL=https://example.com/datenschutz
# PLAYGROUND_LINK_PRIVACY_LABEL=Datenschutz
# PLAYGROUND_LINK_TERMS_URL=https://example.com/nutzungsbedingungen
# PLAYGROUND_LINK_TERMS_LABEL=Nutzungsbedingungen
# PLAYGROUND_LINK_AI_HOSTING_URL=https://www.mittwald.de/mstudio/ai-hosting
# PLAYGROUND_LINK_AI_HOSTING_LABEL=AI Hosting
# PLAYGROUND_LINK_DOCS_URL=https://developer.mittwald.de/de/docs/v2/platform/aihosting/
# PLAYGROUND_LINK_DOCS_LABEL=Developer-Dokumentation
# PLAYGROUND_LINK_BUG_URL=https://github.com/org/repo/issues/new
# PLAYGROUND_LINK_BUG_LABEL=Bug melden

# Spracheingabe (Whisper über mittwald AI-Hosting)
# PLAYGROUND_WHISPER_MODEL=whisper-large-v3-turbo
# PLAYGROUND_WHISPER_LANGUAGE=de
# PLAYGROUND_MAX_AUDIO_BYTES=26214400
# RATE_LIMIT_MAX_TRANSCRIBE=30

# Websuche — Google via SerpAPI (empfohlen für stabile Treffer, z. B. WM-Spieltag)
# WEB_SEARCH_PROVIDER=serpapi
# WEB_SEARCH_SERPAPI_API_KEY=
# WEB_SEARCH_MAX_RESULTS=10
# WEB_SEARCH_GOOGLE_GL=de
# WEB_SEARCH_GOOGLE_HL=de
# WEB_SEARCH_GOOGLE_LOCATION=Germany
# WEB_SEARCH_GOOGLE_DOMAIN=google.de
# Fallback ohne API-Key: WEB_SEARCH_PROVIDER=duckduckgo
# Optional: Mittwald-Modell für Kurz-Google-Query aus Chat
# WEB_SEARCH_QUERY_MODEL=Ministral-3-14B-Instruct-2512
# Optional: Google via Serper — WEB_SEARCH_PROVIDER=serper + WEB_SEARCH_SERPER_API_KEY=
# Optional: GitHub-Token für höhere Rate-Limits (Feature-Requests-Feed)
# GITHUB_TOKEN=
# Websuche: RATE_LIMIT_MAX_WEB_SEARCH=30
